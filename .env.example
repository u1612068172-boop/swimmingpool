# Copy this file to .env and fill in your real credentials.
# For Gmail: enable 2-Step Verification, then create an "App Password"
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.

OWNER_EMAIL=youremail@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_app_password_here

POOL_NAME=Agua the Dip
POOL_LOCATION=Dhinde Kalan, Near Asian Public School
POOL_PHONE=+91 70069 48378

# Razorpay — sign up at https://dashboard.razorpay.com
# Use rzp_test_... + matching secret for testing, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
PRICE_PER_HOUR=200
